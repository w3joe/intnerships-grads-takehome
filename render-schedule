#!/usr/bin/env python3
"""Command-line interface for the on-call scheduler."""

import argparse
import json

from scheduler import render_schedule


def _load_json(path: str, label: str) -> object:
    try:
        with open(path, encoding="utf-8") as source:
            return json.load(source)
    except (OSError, UnicodeError, ValueError) as error:
        raise ValueError(f"cannot load {label} file {path!r}: {error}") from error


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Render an on-call rotation, including temporary overrides."
    )
    parser.add_argument("--schedule", required=True, help="schedule JSON file")
    parser.add_argument("--overrides", required=True, help="JSON array of overrides")
    parser.add_argument(
        "--from", dest="from_time", required=True,
        help="inclusive start timestamp with timezone",
    )
    parser.add_argument(
        "--until", required=True, help="exclusive end timestamp with timezone"
    )
    args = parser.parse_args()
    try:
        result = render_schedule(
            _load_json(args.schedule, "schedule"),
            _load_json(args.overrides, "overrides"),
            args.from_time,
            args.until,
        )
    except ValueError as error:
        parser.error(str(error))
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
